-- Obsidian Legion: a statically generated website written in Unison.
-- UCM evaluates the content, reusable components, and page composition.

use Text ++

legion.repo : Text
legion.repo = "https://github.com/wolfbreed1829/obsidian-legion"

legion.escape : Text -> Text
legion.escape value =
  value
    |> Text.replaceAll "&" "&amp;"
    |> Text.replaceAll "<" "&lt;"
    |> Text.replaceAll ">" "&gt;"
    |> Text.replaceAll "\"" "&quot;"

structural type Discipline = Discipline Text Text Text Text Text Text Text Text

legion.disciplines : [Discipline]
legion.disciplines =
  [ Discipline "code" "01" "Programmers" "MAKE SOMETHING" "THAT MATTERS."
      "Turn the tool you wish existed into the tool you use every day. Write deliberate code. Share what you learn. Make it yours."
      "CLI tools / Developer workflows / Local-first apps"
      "-- Small ideas. Real programs.\n\nhelloLegion : '{IO, Exception} ()\nhelloLegion = do\n  printLine \"Build for yourself.\"\n  printLine \"Build with the Legion.\""
  , Discipline "systems" "02" "Systems engineers" "OWN THE STACK."
      "KNOW EVERY LAYER."
      "Build infrastructure you understand, automate the repetitive work, and make systems you can observe, repair, and trust."
      "Home labs / Automation / Resilient infrastructure"
      "# An independent systems blueprint\n\n01  Define the workload\n02  Provision reproducibly\n03  Instrument every boundary\n04  Test the failure paths\n05  Document the recovery"
  , Discipline "architecture" "03" "System architects" "THINK IN SYSTEMS."
      "BUILD WITH INTENT."
      "Trace the boundaries. Challenge the tradeoffs. Design a system that serves its builders and leaves room for what comes next."
      "System design / Architecture decisions / Distributed systems"
      "CONTEXT    What are we solving?\n\nBOUNDARIES Where does ownership live?\n\nTRADEOFFS  What are we choosing?\n\nEVOLUTION  What can change safely?"
  ]

legion.renderTab : Discipline -> Text
legion.renderTab discipline =
  match discipline with
    Discipline key number title _ _ _ _ _ ->
      "<button class=\"craft-tab\" id=\"tab-" ++ key ++ "\" role=\"tab\" aria-controls=\"panel-" ++ key ++ "\" aria-selected=\"" ++ (if key == "code" then "true" else "false") ++ "\" tabindex=\"" ++ (if key == "code" then "0" else "-1") ++ "\" data-tab=\"" ++ key ++ "\"><span class=\"mono tab-number\">" ++ number ++ "</span>" ++ title ++ "<span class=\"tab-arrow\" aria-hidden=\"true\">↗</span></button>"

legion.renderPanel : Discipline -> Text
legion.renderPanel discipline =
  match discipline with
    Discipline key _ title lineOne lineTwo description topics code ->
      "<section class=\"craft-panel\" id=\"panel-" ++ key ++ "\" role=\"tabpanel\" aria-labelledby=\"tab-" ++ key ++ "\" tabindex=\"0\"" ++ (if key == "code" then "" else " hidden") ++ ">"
        ++ "<div class=\"craft-copy\"><h3>" ++ lineOne ++ "<br><span class=\"muted\">" ++ lineTwo ++ "</span></h3><p>" ++ description ++ "</p><p class=\"mono craft-topics\">" ++ topics ++ "</p><a class=\"text-link\" href=\"#build\">Find your starting point <span aria-hidden=\"true\">↗</span></a></div>"
        ++ "<div class=\"code-window\"><div class=\"code-header mono\"><span><i></i><i></i><i></i></span><span>" ++ (if key == "code" then "hello-legion.u" else "legion / " ++ key) ++ "</span><span>" ++ (if key == "code" then "UNISON" else "FIELD NOTES") ++ "</span></div><pre><code>" ++ legion.escape code ++ "</code></pre><div class=\"code-footer mono\"><span class=\"status-dot\"></span>" ++ (if key == "code" then "A small beginning. An open possibility." else "A starting point for your next build.") ++ "</div></div></section>"

structural type Principle = Principle Text Text Text

legion.principles : [Principle]
legion.principles =
  [ Principle "01" "Sovereignty" "Understand your tools. Own your decisions. Keep the freedom to change both."
  , Principle "02" "Craft" "Care about the details, from the first function to the last failure mode."
  , Principle "03" "Shared knowledge" "Document the process. Share the lessons. Give the next builder a head start."
  ]

legion.renderPrinciple : Principle -> Text
legion.renderPrinciple principle =
  match principle with
    Principle number title description ->
      "<article class=\"principle\"><span class=\"mono\">/ " ++ number ++ "</span><h3>" ++ title ++ "</h3><p>" ++ description ++ "</p></article>"

legion.head : Text
legion.head =
  """
  <!doctype html>
  <html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000">
    <meta name="description" content="Obsidian Legion. A meeting ground for programmers, systems engineers, and system architects building on their own terms. Built with Unison.">
    <meta property="og:title" content="Obsidian Legion — Build on your own terms.">
    <meta property="og:description" content="Your ideas. Your systems. Your rules. A collective for independent builders.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://wolfbreed1829.github.io/obsidian-legion/">
    <meta property="og:image" content="https://wolfbreed1829.github.io/obsidian-legion/assets/obsidian-legion.png">
    <title>Obsidian Legion — Build on your own terms.</title>
    <link rel="icon" type="image/png" href="assets/obsidian-legion.png">
    <link rel="preload" href="assets/obsidian-legion.png" as="image">
    <link rel="stylesheet" href="styles.css">
    <script src="site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="#" aria-label="Obsidian Legion home"><img src="assets/obsidian-legion.png" alt="" width="48" height="48"><span>OBSIDIAN<span>LEGION</span></span></a>
      <button class="menu-toggle mono" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">+</span></button>
      <nav class="navigation" id="navigation" aria-label="Main navigation">
        <a href="#manifesto">The ethos</a><a href="#collective">The collective</a><a href="#build">Start building</a>
        <a class="nav-github" href="https://github.com/wolfbreed1829/obsidian-legion">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow mono"><span class="status-dot"></span> INDEPENDENT MINDS. SHARED AMBITION.</p>
          <h1 id="hero-title">YOUR IDEAS.<br>YOUR SYSTEMS.<br><span class="outline">YOUR RULES.</span></h1>
          <p class="hero-description">For the ones who would rather build it themselves.<br class="desktop-break"> Programmers. Systems engineers. System architects.<br class="desktop-break"> One collective. Endless possibility.</p>
          <div class="hero-actions"><a class="button button-light" href="#collective">Find your place <span aria-hidden="true">↗</span></a><a class="text-link" href="#manifesto">Read the manifesto <span aria-hidden="true">↓</span></a></div>
          <p class="hero-footnote mono">BUILT WITH UNISON <span>/</span> MADE FOR BUILDERS</p>
        </div>
        <figure class="hero-art">
          <span class="art-coordinate mono" aria-hidden="true">FIG. 001 — THE LEGION</span>
          <div class="emblem-frame"><img class="hero-emblem" src="assets/obsidian-legion.png" alt="The Obsidian Legion emblem: interlocking black crystal blades with sharp silver edges" width="1280" height="1280" fetchpriority="high"><span class="art-cross cross-top" aria-hidden="true">+</span><span class="art-cross cross-bottom" aria-hidden="true">+</span></div>
          <figcaption class="mono"><span>FORGED FROM INDEPENDENT MINDS</span><span aria-hidden="true">↗</span></figcaption>
        </figure>
      </section>
      <div class="discipline-strip wrap mono" aria-label="Our disciplines"><span>CODE WITH PURPOSE</span><span class="strip-symbol" aria-hidden="true">✳</span><span>ENGINEER WITH PRECISION</span><span class="strip-symbol" aria-hidden="true">✳</span><span>ARCHITECT WHAT'S NEXT</span></div>
      <section class="manifesto wrap section" id="manifesto" aria-labelledby="manifesto-title">
        <div class="section-label"><p class="eyebrow mono">01 / THE ETHOS</p><p class="section-side-note">Independent by design.<br>Stronger by connection.</p></div>
        <div class="manifesto-body"><h2 id="manifesto-title">Don't just use<br>someone else's world.<br><span class="muted">Build your own.</span></h2><div class="manifesto-text"><p>Obsidian Legion is a meeting ground for people who look at a system and see what it could become. People who open the hood, question the defaults, and make something of their own.</p><p>Bring your curiosity, your unfinished idea, your hard-won experience. The work is yours. The knowledge is something we can build together.</p></div>
  """

legion.collective : Text
legion.collective =
  """
      </div></section>
      <section class="collective wrap section" id="collective" aria-labelledby="collective-title">
        <div class="section-heading"><div><p class="eyebrow mono">02 / THE COLLECTIVE</p><h2 id="collective-title">Different disciplines.<br><span class="muted">The same drive.</span></h2></div><p>From a line of code to an entire ecosystem.<br>There's a place for your kind of builder.</p></div>
        <div class="craft-tabs" role="tablist" aria-label="Choose your discipline">
  """
    ++ Text.join "" (List.map legion.renderTab legion.disciplines)
    ++ "</div><div class=\"craft-panels\">"
    ++ Text.join "" (List.map legion.renderPanel legion.disciplines)
    ++ "</div></section>"

legion.build : Text
legion.build =
  """
      <section class="build-section wrap section" id="build" aria-labelledby="build-title">
        <div class="section-heading"><div><p class="eyebrow mono">03 / YOUR NEXT BUILD</p><h2 id="build-title">Start with an itch.<br><span class="muted">Build the answer.</span></h2></div><p>A few starting points. No prescribed stack.<br>Pick a direction and make it your own.</p></div>
        <div class="build-list">
          <a class="build-row" href="https://github.com/wolfbreed1829/obsidian-legion/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+A+tool+I+wish+existed"><span class="mono build-number">01 /</span><div><h3>The tool you wish existed</h3><p>Replace a daily frustration with something you made.</p></div><span class="mono build-category">SOFTWARE</span><span class="row-arrow" aria-hidden="true">↗</span></a>
          <a class="build-row" href="https://github.com/wolfbreed1829/obsidian-legion/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+My+own+infrastructure"><span class="mono build-number">02 /</span><div><h3>Your own corner of the internet</h3><p>Build a home lab. Run your services. Understand your stack.</p></div><span class="mono build-category">INFRASTRUCTURE</span><span class="row-arrow" aria-hidden="true">↗</span></a>
          <a class="build-row" href="https://github.com/wolfbreed1829/obsidian-legion/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+A+better+system"><span class="mono build-number">03 /</span><div><h3>A system that can grow with you</h3><p>Sketch the boundaries. Write the decisions. Test the tradeoffs.</p></div><span class="mono build-category">ARCHITECTURE</span><span class="row-arrow" aria-hidden="true">↗</span></a>
        </div>
        <p class="build-note mono">CHOOSE A STARTING POINT TO OPEN A BUILD PROPOSAL ON GITHUB.</p>
      </section>
      <section class="join wrap section" id="join" aria-labelledby="join-title"><p class="eyebrow mono"><span class="status-dot"></span> YOUR NEXT CHAPTER STARTS WITH A COMMIT.</p><h2 id="join-title">BUILD FOR YOURSELF.<br><span class="outline">NOT BY YOURSELF.</span></h2><div class="join-bottom"><p>Bring an idea. Open an issue. Improve what's here.<br>Help define what the Obsidian Legion becomes.</p><a class="button button-light" href="https://github.com/wolfbreed1829/obsidian-legion">Build with the Legion <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer wrap"><a class="brand footer-brand" href="#" aria-label="Obsidian Legion home"><img src="assets/obsidian-legion.png" alt="" width="40" height="40"><span>OBSIDIAN<span>LEGION</span></span></a><p class="mono">INDEPENDENT BY DESIGN.</p><div><a href="https://github.com/wolfbreed1829/obsidian-legion">Source ↗</a><a href="https://www.unison-lang.org/">Built with Unison ↗</a><a href="assets/obsidian-legion.png" download="obsidian-legion-logo.png">Get the mark ↓</a></div></footer>
    <noscript><style>.craft-tabs{display:none}.craft-panel[hidden]{display:grid}.craft-panel{border-bottom:1px solid #292929;padding-bottom:3rem}.menu-toggle{display:none}@media(max-width:760px){.navigation{display:flex!important;position:static;flex-wrap:wrap;width:100%}.site-header{flex-wrap:wrap}}</style></noscript>
  </body>
  </html>
  """

legion.page : Text
legion.page =
  legion.head
    ++ "<div class=\"principles\">"
    ++ Text.join "" (List.map legion.renderPrinciple legion.principles)
    ++ "</div>"
    ++ legion.collective
    ++ legion.build

legion.main : '{IO, Exception} ()
legion.main = do
  printLine legion.page
