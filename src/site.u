-- Obsidian Legion: five static pages, composed and compiled in Unison.
use Text ++

legion.escape : Text -> Text
legion.escape value =
  value
    |> Text.replaceAll "&" "&amp;"
    |> Text.replaceAll "<" "&lt;"
    |> Text.replaceAll ">" "&gt;"
    |> Text.replaceAll "\"" "&quot;"

legion.navLink : Text -> Text -> Text -> Text
legion.navLink current file label =
  "<a href=\"" ++ file ++ "\"" ++ (if current == file then " aria-current=\"page\"" else "") ++ ">" ++ label ++ "</a>"

legion.header : Text -> Text
legion.header current =
  """
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="brand" href="index.html" aria-label="Obsidian Legion home"><img src="assets/obsidian-legion-eagle.jpg" alt="" width="50" height="50"><span>OBSIDIAN<span>LEGION</span></span></a>
    <button class="menu-toggle mono" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">+</span></button>
    <nav class="navigation" id="navigation" aria-label="Main navigation">
  """
    ++ legion.navLink current "ethos.html" "The ethos"
    ++ legion.navLink current "collective.html" "The collective"
    ++ legion.navLink current "build.html" "Start building"
    ++ "<span class=\"nav-join\">" ++ legion.navLink current "join.html" "Join the Legion ↗" ++ "</span></nav></header>"

legion.footer : Text
legion.footer =
  """
  <footer class="site-footer wrap">
    <a class="brand footer-brand" href="index.html" aria-label="Obsidian Legion home"><img src="assets/obsidian-legion-eagle.jpg" alt="" width="40" height="40"><span>OBSIDIAN<span>LEGION</span></span></a>
    <p class="mono">INDEPENDENT BY DESIGN.</p>
    <div><a href="https://github.com/Obsidian-Legion">GitHub ↗</a><a href="https://github.com/wolfbreed1829/obsidian-legion">Source ↗</a><a href="https://www.unison-lang.org/">Built with Unison ↗</a><a href="https://obsidian-legion-enlistment.littlecrowsbe.chatgpt.site/admin">Administration ↗</a></div>
  </footer>
  <noscript><style>.craft-tabs{display:none}.craft-panel[hidden]{display:grid!important}.craft-panel{border-bottom:1px solid #30261c;padding-bottom:2rem}.menu-toggle{display:none}@media(max-width:900px){.navigation{display:flex!important;position:static;flex-wrap:wrap;width:100%}.site-header{flex-wrap:wrap;height:auto;padding-block:20px}}</style></noscript>
  """

legion.document : Text -> Text -> Text -> Text -> Text
legion.document file title description body =
  "<!doctype html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"theme-color\" content=\"#000000\">"
    ++ "<title>" ++ legion.escape title ++ "</title><meta name=\"description\" content=\"" ++ legion.escape description ++ "\">"
    ++ "<link rel=\"canonical\" href=\"https://wolfbreed1829.github.io/obsidian-legion/" ++ (if file == "index.html" then "" else file) ++ "\">"
    ++ "<meta property=\"og:title\" content=\"" ++ legion.escape title ++ "\"><meta property=\"og:description\" content=\"" ++ legion.escape description ++ "\"><meta property=\"og:type\" content=\"website\">"
    ++ "<meta property=\"og:url\" content=\"https://wolfbreed1829.github.io/obsidian-legion/" ++ (if file == "index.html" then "" else file) ++ "\"><meta property=\"og:image\" content=\"https://wolfbreed1829.github.io/obsidian-legion/assets/obsidian-legion-eagle.jpg\">"
    ++ "<link rel=\"icon\" type=\"image/jpeg\" href=\"assets/obsidian-legion-eagle.jpg\"><link rel=\"stylesheet\" href=\"styles.css?v=chapters-1\"><script src=\"site.js?v=chapters-1\" defer></script></head><body>"
    ++ legion.header file ++ "<main id=\"main\">" ++ body ++ "</main>" ++ legion.footer ++ "</body></html>"

legion.homeBody : Text
legion.homeBody =
  """
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow mono"><span class="status-dot"></span> INDEPENDENT MINDS. SHARED AMBITION.</p>
      <h1 id="hero-title">YOUR IDEAS.<br>YOUR SYSTEMS.<br><span class="outline">YOUR RULES.</span></h1>
      <p class="hero-description">For the ones who would rather build it themselves.<br class="desktop-break"> Programmers. Systems engineers. System architects.<br class="desktop-break"> One collective. Endless possibility.</p>
      <div class="hero-actions"><a class="button button-light" href="join.html">Become a Legionnaire <span aria-hidden="true">↗</span></a><a class="text-link" href="build.html">Find your next build <span aria-hidden="true">↗</span></a></div>
      <p class="hero-footnote mono">BUILT WITH UNISON <span>/</span> MADE FOR BUILDERS</p>
    </div>
    <figure class="hero-art">
      <span class="art-coordinate mono" aria-hidden="true">FIG. 001 — THE LEGION</span>
      <div class="emblem-frame"><img class="hero-emblem" src="assets/obsidian-legion-eagle.jpg" alt="Obsidian Legion: a black and silver eagle with outstretched wings, a globe, and glowing red accents" width="1254" height="1254" fetchpriority="high"><span class="art-cross cross-top" aria-hidden="true">+</span><span class="art-cross cross-bottom" aria-hidden="true">+</span></div>
      <figcaption class="mono"><span>FORGED FROM INDEPENDENT MINDS</span><a href="assets/obsidian-legion-eagle.jpg" download="obsidian-legion-logo.jpg" aria-label="Download the Obsidian Legion crest">↓</a></figcaption>
    </figure>
  </section>
  <nav class="chapter-links wrap" aria-label="Explore the Legion">
    <a href="ethos.html"><span class="mono">01 / THE ETHOS</span><h2>What we stand for <span aria-hidden="true">↗</span></h2><p>Independence. Craft. Knowledge shared.</p></a>
    <a href="collective.html"><span class="mono">02 / THE COLLECTIVE</span><h2>Find your people <span aria-hidden="true">↗</span></h2><p>Three disciplines. A common drive to build.</p></a>
    <a href="build.html"><span class="mono">03 / START BUILDING</span><h2>Make your first move <span aria-hidden="true">↗</span></h2><p>Choose a problem. Ship something useful.</p></a>
  </nav>
  """

legion.ethosBody : Text
legion.ethosBody =
  """
  <article class="page-shell wrap">
    <header class="page-heading"><div><p class="eyebrow mono">01 / THE ETHOS</p><h1>Build your own.<br><span class="muted">Build it with intent.</span></h1></div><p>Independence is a practice.<br>Curiosity is where it begins.</p></header>
    <div class="manifesto-opening"><p class="manifesto-lead">We believe the people who use a system should have the knowledge and freedom to shape it.</p><div><p>Obsidian Legion is a meeting ground for people who open the hood, question the defaults, and make something of their own. A useful tool, a dependable service, a better way to connect the pieces.</p><p>The work is yours. The lessons can belong to everyone. Bring the unfinished idea, show your reasoning, and leave the next builder a clearer path.</p></div></div>
    <div class="principles">
      <section class="principle"><span class="mono">I / SOVEREIGNTY</span><h2>Understand what you own.</h2><p>Choose tools you can inspect, maintain, and move beyond. Independence grows when you understand the decisions beneath the interface.</p><div class="practice"><span class="mono">PUT IT INTO PRACTICE</span><p>Document your dependencies. Know where your data lives. Make a way out before you need one.</p></div></section>
      <section class="principle"><span class="mono">II / CRAFT</span><h2>Make the details count.</h2><p>A system earns trust through the work behind it: clear code, observable behavior, and failure paths someone has actually considered.</p><div class="practice"><span class="mono">PUT IT INTO PRACTICE</span><p>Build the smallest useful version. Test its boundaries. Leave it easier to understand than you found it.</p></div></section>
      <section class="principle"><span class="mono">III / SHARED KNOWLEDGE</span><h2>Leave a trail worth following.</h2><p>Share the decision as well as the result. The experiment that failed can teach as much as the release that worked.</p><div class="practice"><span class="mono">PUT IT INTO PRACTICE</span><p>Write the setup steps. Explain the tradeoffs. Credit the work that helped yours happen.</p></div></section>
    </div>
    <aside class="page-callout"><div><p class="eyebrow mono">HOW WE WORK TOGETHER</p><p>Question ideas with care. Give specific feedback. Respect the person doing the work.</p></div><a class="text-link" href="collective.html">Meet the collective <span aria-hidden="true">↗</span></a></aside>
  </article>
  """

structural type Discipline = Discipline Text Text Text Text Text Text Text Text Text

legion.disciplines : [Discipline]
legion.disciplines =
  [ Discipline "code" "01" "Programmers" "MAKE SOMETHING" "THAT MATTERS."
      "Turn the tool you wish existed into the tool you use every day. Write deliberate code, reduce friction, and bring the useful little programs out of your private folder."
      "CLI tools / Developer workflows / Local-first apps"
      "Bring a small, working tool with a README and one example. Ask another builder to run it without your help. Their questions are your next improvements."
      "-- Small ideas. Real programs.\n\nhelloLegion : '{IO, Exception} ()\nhelloLegion = do\n  printLine \"Build for yourself.\"\n  printLine \"Build with the Legion.\""
  , Discipline "systems" "02" "Systems engineers" "OWN THE STACK." "KNOW EVERY LAYER."
      "Build infrastructure you understand. Automate the repetitive work, make the important behavior visible, and know how to recover when the happy path ends."
      "Home labs / Automation / Resilient infrastructure"
      "Share a reproducible service setup, its health checks, and a recovery runbook. Invite someone to rebuild it from a clean environment."
      "# A system you can trust\n\n01  Define the workload\n02  Provision reproducibly\n03  Observe the boundaries\n04  Test the failure paths\n05  Rehearse the recovery"
  , Discipline "architecture" "03" "System architects" "THINK IN SYSTEMS." "BUILD WITH INTENT."
      "Trace the boundaries and challenge the assumptions. Design around real constraints, make the tradeoffs explicit, and leave room for what comes next."
      "System design / Architecture decisions / Distributed systems"
      "Bring a context diagram and one architecture decision record. Name an alternative you rejected and the evidence that could change your mind."
      "CONTEXT    What are we solving?\n\nBOUNDARIES Where does ownership live?\n\nTRADEOFFS  What are we choosing?\n\nEVOLUTION  What can change safely?"
  ]

legion.renderTab : Discipline -> Text
legion.renderTab discipline =
  match discipline with
    Discipline key number title _ _ _ _ _ _ ->
      "<button class=\"craft-tab\" id=\"tab-" ++ key ++ "\" role=\"tab\" aria-controls=\"panel-" ++ key ++ "\" aria-selected=\"" ++ (if key == "code" then "true" else "false") ++ "\" tabindex=\"" ++ (if key == "code" then "0" else "-1") ++ "\" data-tab=\"" ++ key ++ "\"><span class=\"mono tab-number\">" ++ number ++ "</span>" ++ title ++ "<span class=\"tab-arrow\" aria-hidden=\"true\">↗</span></button>"

legion.renderPanel : Discipline -> Text
legion.renderPanel discipline =
  match discipline with
    Discipline key _ _ lineOne lineTwo description topics contribution code ->
      "<section class=\"craft-panel\" id=\"panel-" ++ key ++ "\" role=\"tabpanel\" aria-labelledby=\"tab-" ++ key ++ "\" tabindex=\"0\"" ++ (if key == "code" then "" else " hidden") ++ ">"
        ++ "<div class=\"craft-copy\"><h2>" ++ lineOne ++ "<br><span class=\"muted\">" ++ lineTwo ++ "</span></h2><p>" ++ description ++ "</p><p class=\"mono craft-topics\">" ++ topics ++ "</p><div class=\"first-contribution\"><h3 class=\"mono\">YOUR FIRST CONTRIBUTION</h3><p>" ++ contribution ++ "</p></div><a class=\"text-link\" href=\"build.html\">Find your starting point <span aria-hidden=\"true\">↗</span></a></div>"
        ++ "<div class=\"code-window\"><div class=\"code-header mono\"><span><i></i><i></i><i></i></span><span>" ++ (if key == "code" then "hello-legion.u" else "legion / " ++ key) ++ "</span><span>" ++ (if key == "code" then "UNISON" else "FIELD NOTES") ++ "</span></div><pre><code>" ++ legion.escape code ++ "</code></pre><div class=\"code-footer mono\"><span class=\"status-dot\"></span>A starting point. Make it your own.</div></div></section>"

legion.collectiveBody : Text
legion.collectiveBody =
  """
  <article class="page-shell wrap">
    <header class="page-heading"><div><p class="eyebrow mono">02 / THE COLLECTIVE</p><h1>Different disciplines.<br><span class="muted">The same drive.</span></h1></div><p>No single stack. No fixed lane.<br>Find your place, then cross the boundaries.</p></header>
    <div class="craft-tabs" role="tablist" aria-label="Choose your discipline">
  """
    ++ Text.join "" (List.map legion.renderTab legion.disciplines)
    ++ "</div><div class=\"craft-panels\">" ++ Text.join "" (List.map legion.renderPanel legion.disciplines) ++ "</div>"
    ++ """
    <aside class="page-callout"><div><p class="eyebrow mono">THE CONVERSATION STARTS WITH YOUR WORK</p><p>Share a build, ask for a second pair of eyes, or help someone get unstuck.</p></div><div class="callout-actions"><a class="text-link" href="https://github.com/Obsidian-Legion/community/discussions">Open discussions ↗</a><a class="button button-light" href="join.html">Join the Legion <span aria-hidden="true">↗</span></a></div></aside>
  </article>
  """

legion.buildBody : Text
legion.buildBody =
  """
  <article class="page-shell wrap">
    <header class="page-heading"><div><p class="eyebrow mono">03 / START BUILDING</p><h1>Start with an itch.<br><span class="muted">Build the answer.</span></h1></div><p>A small scope. A clear finish line.<br>Choose a starting point and make it yours.</p></header>
    <div class="blueprints">
      <section class="blueprint"><p class="mono blueprint-label">01 / SOFTWARE</p><h2>The tool you<br>wish existed.</h2><p>Replace one repeated frustration with a program you actually use. A CLI, a local app, or a better workflow.</p><dl><dt>FIRST MILESTONE</dt><dd>One input, one useful result. Make the core workflow run end to end.</dd><dt>DONE LOOKS LIKE</dt><dd>A working example, setup instructions, and checks for the most likely failure.</dd></dl><a class="text-link" href="https://github.com/Obsidian-Legion/community/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+A+tool+I+wish+existed">Propose a software build <span aria-hidden="true">↗</span></a></section>
      <section class="blueprint"><p class="mono blueprint-label">02 / INFRASTRUCTURE</p><h2>Your own corner<br>of the internet.</h2><p>Run a service on infrastructure you understand. Start with a home lab and learn every layer that keeps it alive.</p><dl><dt>FIRST MILESTONE</dt><dd>One service, a repeatable deployment, and a health check you can trust.</dd><dt>DONE LOOKS LIKE</dt><dd>A setup guide, a backup, and a successful restore from a clean environment.</dd></dl><a class="text-link" href="https://github.com/Obsidian-Legion/community/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+My+own+infrastructure">Propose an infrastructure build <span aria-hidden="true">↗</span></a></section>
      <section class="blueprint"><p class="mono blueprint-label">03 / ARCHITECTURE</p><h2>A system that<br>can grow with you.</h2><p>Map a real problem before adding more pieces. Define the boundaries, then test the decision with the most uncertainty.</p><dl><dt>FIRST MILESTONE</dt><dd>A context diagram, clear constraints, and one recorded design decision.</dd><dt>DONE LOOKS LIKE</dt><dd>A small prototype that tests a tradeoff, with evidence and a next decision.</dd></dl><a class="text-link" href="https://github.com/Obsidian-Legion/community/issues/new?template=build-idea.yml&amp;title=Build+idea%3A+A+better+system">Propose an architecture build <span aria-hidden="true">↗</span></a></section>
    </div>
    <section class="build-workflow" aria-labelledby="workflow-title"><div><p class="eyebrow mono">FROM IDEA TO SHARED WORK</p><h2 id="workflow-title">Make the next step clear.</h2></div><ol><li><strong>Propose</strong><span>Name the problem, first milestone, and where you need help.</span></li><li><strong>Build</strong><span>Work in your repo. Keep the scope small and the progress visible.</span></li><li><strong>Share</strong><span>Link the result and explain what worked, what failed, and what's next.</span></li></ol></section>
    <p class="build-note mono">PROPOSALS OPEN IN GITHUB AND REQUIRE SIGN-IN. YOUR CHOICE OF TOOLS STAYS YOURS.</p>
  </article>
  """

legion.joinBody : Text
legion.joinBody =
  """
  <section class="page-shell wrap enlist-section" aria-labelledby="join-title">
    <div class="enlist-intro"><p class="eyebrow mono"><span class="status-dot"></span> 04 / YOUR NEXT CHAPTER</p><h1 id="join-title">BECOME A<br><span class="outline">LEGIONNAIRE.</span></h1><p>Bring what you know.<br>Build what you need.<br>Find your people.</p><div class="enlist-details"><span class="mono">WHAT HAPPENS NEXT</span><p>Your application goes to the Legion administrators for review. Tell us what you care about building and where you want to contribute.</p><p>Acceptance and GitHub invitations are reviewed separately. Applying does not automatically add you to the organization.</p><a class="text-link" href="https://github.com/Obsidian-Legion">Explore our GitHub <span aria-hidden="true">↗</span></a></div></div>
    <div class="enlist-panel"><p class="eyebrow mono">YOUR APPLICATION</p><h2>Your place starts here.</h2><p class="enlist-subtitle">A little about you. A glimpse of what's next.</p>
      <form id="legionnaire-form" action="https://obsidian-legion-enlistment.littlecrowsbe.chatgpt.site/api/applications" method="post">
        <div class="enlist-fields"><label>Your name<input name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="What should we call you?"></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"></label></div>
        <div class="enlist-fields"><label>Your discipline<select name="discipline" required><option value="" disabled selected>Select your discipline</option><option>Programmer</option><option>Systems engineer</option><option>System architect</option><option>Exploring / multidisciplinary</option></select></label><label>GitHub profile <span class="optional">optional</span><input name="github" maxlength="100" autocomplete="off" placeholder="@username or profile URL"></label></div>
        <label>What do you want to build?<textarea name="motivation" required minlength="20" maxlength="2000" rows="4" aria-describedby="motivation-hint" placeholder="Your ideas, your experience, or the problem you can't leave alone…"></textarea><span class="enlist-hint" id="motivation-hint">20–2,000 characters. Leave passwords and sensitive project details out.</span></label>
        <div class="form-trap" aria-hidden="true"><label>Company<input name="company" tabindex="-1" autocomplete="off"></label></div>
        <label class="enlist-consent"><input type="checkbox" name="consent" value="yes" required><span>I agree to share these details with the Obsidian Legion administrators so they can review my application and contact me about joining.</span></label>
        <p id="signup-error" class="signup-error" role="alert" hidden></p>
        <button class="button button-light enlist-submit" type="submit"><span>Apply to become a Legionnaire</span><span aria-hidden="true">↗</span></button>
        <p class="enlist-hint">Your application is private. Only approved administrators can review it.</p>
      </form>
      <div id="signup-success" class="signup-success" role="status" tabindex="-1" hidden><span class="success-mark" aria-hidden="true">✓</span><h3>Application received.</h3><p>Your next chapter is in motion. The Legion administrators can now review your application.</p><p>If you have already applied with this email, your original application is kept.</p><a class="text-link" href="https://github.com/Obsidian-Legion">Explore the Legion on GitHub ↗</a></div>
    </div>
  </section>
  """

legion.main : '{IO, Exception} ()
legion.main = do
  printLine (legion.document "index.html" "Obsidian Legion — Build on your own terms." "A collective for programmers, systems engineers, and system architects who build on their own terms. Built with Unison." legion.homeBody)

legion.ethos : '{IO, Exception} ()
legion.ethos = do
  printLine (legion.document "ethos.html" "The Ethos — Obsidian Legion" "Sovereignty, craft, and shared knowledge. The principles behind Obsidian Legion and the practices that make them real." legion.ethosBody)

legion.collectiveMain : '{IO, Exception} ()
legion.collectiveMain = do
  printLine (legion.document "collective.html" "The Collective — Obsidian Legion" "Find your place among programmers, systems engineers, and system architects. Explore your discipline and make your first contribution." legion.collectiveBody)

legion.buildMain : '{IO, Exception} ()
legion.buildMain = do
  printLine (legion.document "build.html" "Start Building — Obsidian Legion" "Three starting points for independent builders. Choose software, infrastructure, or architecture and propose your first useful milestone." legion.buildBody)

legion.join : '{IO, Exception} ()
legion.join = do
  printLine (legion.document "join.html" "Become a Legionnaire — Obsidian Legion" "Apply to join Obsidian Legion. Share your discipline, your experience, and the work you want to build." legion.joinBody)
